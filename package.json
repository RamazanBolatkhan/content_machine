{
  "name": "content-machine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c gray,blue \"next dev\" \"npm:worker\"",
    "dev:web": "next dev",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import-sqlite": "tsx --env-file=.env.local scripts/import-sqlite.ts",
    "scout:loop": "tsx --env-file=.env.local scripts/scout-loop.ts",
    "x:check": "tsx --env-file=.env.local scripts/x-check.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.69",
    "ai": "^7.0.130",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module",
  "license": "MIT"
}
