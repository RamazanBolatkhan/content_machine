# Copy to .env.local and fill in.

# --- Database + storage (vercel env pull fills these in) ---
DATABASE_URL=
# Optional: copy pictures to Vercel Blob
# BLOB_READ_WRITE_TOKEN=
# Website password (set it on Vercel; leave empty locally for no login)
# APP_PASSWORD=

# --- AI ---
# "claude-code" (default): uses the Claude Code CLI on this Mac with your Claude
#   subscription, no API cost. Personal use only. Run `claude` once to log in.
# "gateway": Vercel AI Gateway, paid per token (needs AI_GATEWAY_API_KEY).
AI_PROVIDER=claude-code
# Claude Code model alias (sonnet, opus, haiku)
CLAUDE_MODEL=sonnet
# Only if the app can't find the `claude` command:
# CLAUDE_BIN=/Users/you/.local/bin/claude

# AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# --- X login, for importing your bookmarks (~$0.001 per bookmark) ---
# X console → your app → User authentication settings:
#   App permissions: Read · Type: Native App (or Web App + secret)
#   Callback URL: http://127.0.0.1:3000/api/x/callback
X_CLIENT_ID=
# Only for a "Web App" (confidential client):
X_CLIENT_SECRET=
# X_REDIRECT_URI=http://127.0.0.1:3000/api/x/callback

# --- Optional: paid X search (~$0.005 per post read), off in Settings by default ---
# X_BEARER_TOKEN=
# X_MODE=mcp
# X_MCP_URL=https://api.x.com/mcp
# X_API_TOOL_ALLOWLIST=searchPostsRecent,getPostsByIds,getUsersByUsername
